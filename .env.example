# Copy to .env.local and fill in. Never commit real values.
# Production values live in Vercel → Project → Settings → Environment Variables.

# Postgres (Neon). Use the "dev" branch locally, never the production branch.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Better Auth: long random string (openssl rand -base64 32) and the site URL.
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3000

# Comma-separated emails that become platform admins when they sign up.
PLATFORM_ADMIN_EMAILS=you@example.com

# Optional: separate key for encrypting stored PayMongo keys (defaults to one derived from BETTER_AUTH_SECRET).
PAYMONGO_ENC_KEY=

# Email (Resend). Without a key, emails are printed to the server log instead.
RESEND_API_KEY=
EMAIL_FROM=Playbook <noreply@your-domain>

# Vercel Cron sends this as a Bearer token to /api/cron/invoices.
CRON_SECRET=change-me
